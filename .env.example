# MySQL de Docker Compose
DATABASE_URL=mysql+pymysql://arinc:arinc_dev_only@127.0.0.1:3306/arinc429?charset=utf8mb4

# Hardware desactivado por seguridad. Solo habilitar con interfaz de laboratorio aislada.
SERIAL_ENABLED=false
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUDRATE=100000

# Reproduce un tono indicativo por el dispositivo de audio predeterminado (no es salida DC).
AUDIO_ENABLED=false
AUDIO_SAMPLE_RATE=44100
